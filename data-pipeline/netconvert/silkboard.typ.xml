<?xml version="1.0" encoding="UTF-8"?>
<!--
  Weave edge types for the Silk Board OSM import (replaces SUMO's osmNetconvert.typ.xml).
  Only motor-traffic road classes are listed; anything else in the extract is dropped.
  width   = default lane width (m), used where OSM has no width tag (the extract has none):
            3.5 m for trunk/primary and their links (IRC:86 / IRC:106 standard urban lane width),
            3.25 m secondary, 3.0 m tertiary (engineering defaults for minor urban roads).
  speed   = default speed limit (m/s) where OSM has no maxspeed tag: urban Bengaluru defaults
            60 km/h trunk, 50 km/h primary, 40 km/h secondary and links, 30 km/h tertiary.
  numLanes= default lanes where OSM has no lanes tag (per direction for oneway ways).
-->
<types>
    <type id="highway.motorway"       numLanes="3" speed="16.67" priority="14" oneway="true"  width="3.5"  allow="passenger bus truck motorcycle delivery"/>
    <type id="highway.trunk"          numLanes="2" speed="16.67" priority="13" oneway="false" width="3.5"  allow="passenger bus truck motorcycle delivery"/>
    <type id="highway.primary"        numLanes="2" speed="13.89" priority="12" oneway="false" width="3.5"  allow="passenger bus truck motorcycle delivery"/>
    <type id="highway.secondary"      numLanes="1" speed="11.11" priority="11" oneway="false" width="3.25" allow="passenger bus truck motorcycle delivery"/>
    <type id="highway.tertiary"       numLanes="1" speed="8.33"  priority="10" oneway="false" width="3.0"  allow="passenger bus truck motorcycle delivery"/>
    <type id="highway.motorway_link"  numLanes="1" speed="11.11" priority="9"  oneway="true"  width="3.5"  allow="passenger bus truck motorcycle delivery"/>
    <type id="highway.trunk_link"     numLanes="1" speed="11.11" priority="8"  oneway="false" width="3.5"  allow="passenger bus truck motorcycle delivery"/>
    <type id="highway.primary_link"   numLanes="1" speed="11.11" priority="7"  oneway="false" width="3.5"  allow="passenger bus truck motorcycle delivery"/>
    <type id="highway.secondary_link" numLanes="1" speed="11.11" priority="6"  oneway="false" width="3.25" allow="passenger bus truck motorcycle delivery"/>
    <type id="highway.tertiary_link"  numLanes="1" speed="11.11" priority="5"  oneway="false" width="3.0"  allow="passenger bus truck motorcycle delivery"/>
</types>
