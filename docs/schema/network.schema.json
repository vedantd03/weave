{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "origin": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "kind": {
            "type": "string",
            "enum": [
              "plain",
              "signal",
              "priority",
              "merge",
              "diverge",
              "boundary"
            ]
          },
          "layer": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "x",
          "y",
          "kind"
        ]
      }
    },
    "links": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "polyline": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "widthM": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "lanes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "speedLimitMps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "layer": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "zFromM": {
            "default": 0,
            "type": "number"
          },
          "zToM": {
            "default": 0,
            "type": "number"
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "polyline",
          "widthM",
          "lanes",
          "speedLimitMps"
        ]
      }
    },
    "movements": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "node": {
            "type": "string",
            "minLength": 1
          },
          "fromLink": {
            "type": "string",
            "minLength": 1
          },
          "toLink": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "widthM": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "fromLateral": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "toLateral": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "control": {
            "type": "string",
            "enum": [
              "signal",
              "major",
              "minor",
              "free"
            ]
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "movement": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "crossing",
                    "merging",
                    "diverging"
                  ]
                },
                "self": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "other": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "required": [
                "movement",
                "type",
                "self",
                "other"
              ]
            }
          },
          "foes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "node",
          "fromLink",
          "toLink",
          "path",
          "widthM",
          "fromLateral",
          "toLateral",
          "control"
        ]
      }
    },
    "signals": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node": {
            "type": "string",
            "minLength": 1
          },
          "offsetS": {
            "default": 0,
            "type": "number",
            "minimum": 0
          },
          "amberS": {
            "default": 3,
            "type": "number",
            "minimum": 0
          },
          "allRedS": {
            "default": 2,
            "type": "number",
            "minimum": 0
          },
          "phases": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "greenS": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "protected": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "permissive": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "greenS",
                "protected"
              ]
            }
          }
        },
        "required": [
          "node",
          "phases"
        ]
      }
    },
    "zones": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "link": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "in",
              "out"
            ]
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "link",
          "role"
        ]
      }
    }
  },
  "required": [
    "version",
    "id",
    "name",
    "nodes",
    "links"
  ]
}
